{
    "name": "spark-yun-website",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.34.3",
    "engines": {
        "node": "22.22.3",
        "pnpm": "10.34.3"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite --mode dev",
        "dev:vip": "VITE_EDITION=vip vite --mode dev",
        "serve-prod": "vite",
        "build": "vite build",
        "build:vip": "VITE_EDITION=vip vite build --mode vip",
        "build-bak": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vite build",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "build-prod": "vite build --mode prod",
        "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "type-check:vip": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "lint": "eslint . --fix",
        "lint-dev": "eslint . --fix",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "@antv/g6": "^5.1.1",
        "@antv/x6": "^1.29.5",
        "@antv/x6-vue-shape": "^1.3.0",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-python": "^6.1.3",
        "@codemirror/lang-sql": "^6.10.0",
        "@element-plus/icons-vue": "2.3.2",
        "axios": "^1.17.0",
        "clipboard": "^2.0.11",
        "dayjs": "^1.11.21",
        "echarts": "^5.4.3",
        "element-plus": "2.14.2",
        "g6-extension-vue": "^0.1.0",
        "jsplumb": "^2.15.6",
        "lodash-es": "^4.18.1",
        "mitt": "^3.0.0",
        "normalize.css": "8.0.1",
        "pinia": "3.0.4",
        "pinia-plugin-persistedstate": "4.7.1",
        "qs": "^6.15.2",
        "validator": "^13.15.35",
        "vue": "3.5.38",
        "vue-codemirror6": "^1.5.2",
        "vue-grid-layout": "3.0.0-beta1",
        "vue-router": "4.6.4",
        "vuedraggable": "^4.1.0",
        "vxe-pc-ui": "4.6.13",
        "vxe-table": "^4.13.32",
        "xe-utils": "^3.5.10"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@tsconfig/node22": "22.0.5",
        "@types/jsdom": "28.0.3",
        "@types/lodash-es": "^4.17.9",
        "@types/node": "22.19.21",
        "@types/validator": "^13.15.10",
        "@vitejs/plugin-vue": "6.0.7",
        "@vitejs/plugin-vue-jsx": "5.1.5",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.8.0",
        "@vue/test-utils": "2.4.11",
        "@vue/tsconfig": "0.9.1",
        "eslint": "^10.4.1",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "17.6.0",
        "jsdom": "29.1.1",
        "prettier": "^3.8.4",
        "sass": "1.101.0",
        "typescript": "5.9.3",
        "unplugin-vue-components": "32.1.0",
        "vite": "8.0.16",
        "vite-plugin-static-copy": "3.4.0",
        "vitest": "4.1.8",
        "vue-tsc": "3.3.4"
    }
}
